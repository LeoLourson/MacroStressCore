{
  "name": "macrostress-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "uv run --frozen msa-plugin ui-manifest",
    "build": "node scripts/check-plugins.mjs && node scripts/check-math.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "precheck-plugins": "uv run --frozen msa-plugin ui-manifest",
    "check-plugins": "node scripts/check-plugins.mjs",
    "check-math": "node scripts/check-math.mjs"
  },
  "dependencies": {
    "@fontsource/golos-text": "5.3.0",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@mantine/notifications": "8.3.18",
    "@noble/hashes": "2.4.0",
    "@tabler/icons-react": "3.48.0",
    "@tanstack/react-query": "5.103.2",
    "@xyflow/react": "12.11.6",
    "katex": "0.16.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "7.18.4",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "postcss": "8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
