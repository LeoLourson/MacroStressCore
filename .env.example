# ops/init_env.py (called by msa.ps1 up) turns this file into .env with unique local
# credentials; it also appends MSA_DATABASE_URL and MSA_API_KEYS. This file holds no secrets.
POSTGRES_PASSWORD=CHANGE_ME
# Personal API keys of the browser app's two roles.
MSA_UI_ANALYST_API_KEY=CHANGE_ME
MSA_UI_RISK_MANAGER_API_KEY=CHANGE_ME

# LLM profile (src/msa/integrations/llm/providers.py): local | deepseek | mock.
#   local    — an OpenAI-compatible server inside the perimeter (vLLM, LM Studio);
#              MSA_LLM_BASE_URL and MSA_LLM_MODEL name it.
#   deepseek — the external DeepSeek API, key from DEEPSEEK_API_KEY in the user environment
#              (never in this file); runs are limited to synthetic demo portfolios.
#   mock     — no model: the graph is built from the portfolio's sectors.
MSA_LLM_PROVIDER=local
MSA_LLM_BASE_URL=http://127.0.0.1:1234/v1
# MSA_LLM_MODEL=
# MSA_LLM_JSON_MODE=json_schema
# MSA_LLM_TIMEOUT=300
# MSA_LLM_MAX_TOKENS=32768

# The bank's approved PD calibration for the production namespace, in the format of
# src/msa/engine/registries/*.json; without it production results stay risk scores.
# MSA_CALIBRATION_REGISTRY=/secure/calibration/bank-2026.json

# Hosts an event may be fetched from by URL (comma-separated, https only).
# MSA_INGEST_URL_HOSTS=www.cbr.ru,publication.pravo.gov.ru

# PDF events need the docling extra and its local model artifacts.
# MSA_DOCLING_ARTIFACTS_PATH=/models/docling

MSA_STORAGE_ROOT=.data/objects
